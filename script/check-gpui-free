#!/usr/bin/env bash
# Fails when a crate that must stay GPUI-independent gains a GPUI dependency.
set -euo pipefail

crates=(subsonic net client audio playback catalog config hiphile-cli)
root="$(cd "$(dirname "$0")/.." && pwd)"
status=0
for crate in "${crates[@]}"; do
  # A path spec, since crates.io also has packages named like ours (`config`).
  spec="path+file://$root/crates/$crate"
  if cargo tree -p "$spec" -e normal --prefix none | grep -qi '^gpui'; then
    echo "error: $crate depends on GPUI" >&2
    cargo tree -p "$spec" -e normal -i gpui-pre 2>/dev/null | head -20 >&2 || true
    status=1
  fi
done
exit "$status"
