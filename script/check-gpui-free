#!/usr/bin/env bash
set -euo pipefail

crates=(
  subsonic net client audio playback presence catalog config fuzzy lyrics media-controls dsd dsp r8brain
  soxr executor updater session hiphile-core hiphile-cli
)
root="$(cd "$(dirname "$0")/.." && pwd)"
# A path spec, since crates.io also has packages named like ours (`config`)
specs=()
for crate in "${crates[@]}"; do
  specs+=("path+file://$root/crates/$crate")
done
# The app on AntiWebUI, which shares the core with the GPUI app but not GPUI. Every crate under
# `next/` is checked, named apart from its folder
for manifest in "$root"/next/*/Cargo.toml; do
  name="$(sed -n 's/^name = "\(.*\)"$/\1/p' "$manifest" | head -n 1)"
  specs+=("path+file://$(dirname "$manifest")#$name")
done
status=0
for spec in "${specs[@]}"; do
  if ! tree="$(cargo tree --locked -p "$spec" -e normal,dev --prefix none)"; then
    echo "error: could not list what $spec depends on" >&2
    status=1
    continue
  fi
  if grep -qi '^gpui' <<<"$tree"; then
    echo "error: $spec depends on GPUI" >&2
    cargo tree --locked -p "$spec" -e normal,dev -i gpui-pre 2>/dev/null | head -20 >&2 || true
    status=1
  fi
done
exit "$status"
